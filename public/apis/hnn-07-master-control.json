                  "licenseFee": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "graceDays": {
                    "type": "integer",
                    "default": 30,
                    "description": "grace window for unlicensed clients after switching to licensed"
                  }
