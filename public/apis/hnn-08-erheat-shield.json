    "/erheat/api/apply": {
      "post": {
        "summary": "Ask for a loan",
        "tags": [
          "ERHEAT borrower"
        ],
        "description": "Creates the request and texts the verifier. With billId the Biller bill is the confirmation (amount cannot exceed the patient share; one request per bill); with facilityId the facility is texted. Everything is in GHS.",
        "security": [
          {
            "BorrowerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "line": "rent",
                "amount": 900,
                "purpose": "November rent",
                "payee": {
                  "name": "Kojo Boateng",
                  "phone": "0200000000"
                },
                "verifier": {
                  "name": "Kojo Boateng",
                  "phone": "0200000000"
                },
                "evidence": {
                  "monthlyRent": "450",
                  "dueDate": "2026-11-01"
                },
                "lang": "en"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request in its borrower view",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "403": {
            "description": "Phone not verified"
          },
          "404": {
            "description": "ERHEAT Shield is not open yet"
          },
          "409": {
            "description": "Line not open, or an open request exists on the line"
          },
          "422": {
            "description": "Amount above the limit or invalid details"
          },
          "429": {
            "description": "Monthly request limit reached"
          }
        }
      }
    },
    "/erheat/api/apps/{id}/consent": {
      "post": {
        "summary": "Consent and submit to the lender",
        "tags": [
          "ERHEAT borrower"
        ],
        "description": "Only when the request is verified. Stores the consent text version and, if a lender URL is set, pushes the signed packet.",
        "security": [
          {
            "BorrowerToken": []
