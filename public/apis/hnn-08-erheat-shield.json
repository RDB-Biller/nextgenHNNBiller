  "components": {
    "securitySchemes": {
      "BorrowerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Patient-account token from POST /patient-api/v1/patient/login (30-day signed token)."
      },
      "PartnerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Partner session token from POST /partner-api/login (12-hour signed token)."
      },
      "SubAdminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sub-admin session token from POST /admin-api/login. Opens only the areas the account was given; sandboxed (demo and evaluator) accounts work on a private scratch copy."
      },
      "PlatformKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-platform-key",
        "description": "Chief administrator key (env PLATFORM_ADMIN_KEY)."
      }
    }
  }
}