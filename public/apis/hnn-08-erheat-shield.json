    "/erheat-hooks/{secret}/decision": {
      "post": {
        "summary": "Lender decision",
        "tags": [
          "ERHEAT lender hooks"
        ],
        "description": "approvedAmount defaults to the verified amount; it must be above zero and at most that amount (never above GHS 2,000). Voucher lines get a voucher on approval.",
        "security": [],
        "parameters": [
          {
            "name": "secret",
            "in": "path",
            "required": true,
            "description": "Hook secret from Master Control > ERHEAT",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "applicationNo": "ERH-482913",
                "decision": "approved",
                "approvedAmount": 900,
                "reference": "CU-7781"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Wrong secret"
          },
          "409": {
            "description": "Request is not in a state that accepts this"
          },
          "422": {
            "description": "Invalid decision or amount"
          }
        }
      }
    },
