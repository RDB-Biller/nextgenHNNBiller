          }
        ],
        "responses": {
          "200": {
            "description": "{ client, name, edition, features{}, licence{ active, expiresAt, daysLeft } }"
          }
        }
      }
    },
    "/api/v1/clinical-observations": {
      "post": {
        "tags": [
          "Clinical"
        ],
        "summary": "Manually record one clinical indicator for a patient (Value-Based-Care)",
        "description": "The tenant-authenticated counterpart to an EMR/EHR partner's own feed \u2014 for a clinic with no EMR integration, or simply keying in today's reading by hand. Same validation and shape as the partner feed; stored with source:manual_hospital. See the Product Lab tag in the Master Control API for the full metric/condition list and how these feed Value-Based-Care scoring.",
        "security": [
          {
            "TenantKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "payerId",
                  "memberId",
                  "type"
                ],
                "properties": {
                  "payerId": {
                    "type": "string"
                  },
                  "memberId": {
                    "type": "string"
                  },
                  "condition": {
                    "type": "string",
                    "enum": [
                      "hypertension",
                      "diabetes",
                      "dyslipidemia"
                    ],
                    "description": "Required if type is complication or followup_visit; blood_pressure/hba1c/ldl infer their condition automatically."
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "blood_pressure",
                      "hba1c",
                      "ldl",
                      "complication",
                      "followup_visit",
                      "screening_completed",
                      "wellness_visit"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "description": "hba1c (%) or ldl (mg/dL)"
                  },
                  "systolic": {
                    "type": "number"
                  },
                  "diastolic": {
                    "type": "number"
                  },
                  "note": {
                    "type": "string"
                  },
                  "recordedAt": {
                    "type": "string",
                    "description": "Defaults to now"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The stored observation"
          },
          "404": {
            "description": "unknown_payer"
          },
          "422": {
            "description": "payerId_required / memberId_required / invalid_type"
          }
        }
      },
      "get": {
        "tags": [
          "Clinical"
        ],
        "summary": "This clinic's own manually-recorded observations for one member",
        "description": "Scoped to what THIS clinic recorded by hand (source:manual_hospital) \u2014 the EMR feed and other clinics' entries for the same member aren't returned here.",
        "security": [
          {
            "TenantKey": []
          }
        ],
        "parameters": [
          {
            "name": "payerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "memberId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ ok: true, count, data: [observation] }"
          },
          "422": {
            "description": "payerId_and_memberId_required"
          }
        }
      }
    },
    "/api/v1/clinical-observations/link": {
      "post": {
        "tags": [
          "Clinical"
        ],
        "summary": "Text a patient a code to set up their own check-ins by phone",
        "description": "Starts the same OTP phone<->member link a patient can self-initiate at the public /clinical/ portal \u2014 a clinic can kick it off during a visit, but the patient still has to confirm the code themselves (reply with it, or enter it at /clinical/) before anything can be submitted from their side. Once active, the patient can text in readings any time (e.g. \"BP 130/85\", \"HBA1C 6.8\", \"LDL 110\", \"COMPLICATION\", \"FOLLOWUP\") or use the web page; STOP opts out immediately, from anyone.",
        "security": [
          {
            "TenantKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "payerId",
                  "memberId",
                  "phone"
                ],
                "properties": {
                  "payerId": {
                    "type": "string"
                  },
                  "memberId": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "condition": {
                    "type": "string",
                    "enum": [
                      "hypertension",
                      "diabetes",
                      "dyslipidemia"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "enum": [
                      "sms",
                      "whatsapp"
                    ],
                    "default": "sms"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "{ id, status: \"pending\", payerId, memberId, condition }. Never echoes the code \u2014 it only goes to the patient's phone."
          },
          "404": {
            "description": "unknown_payer"
          },
          "422": {
            "description": "payerId_required / memberId_required / phone_required / invalid_phone / invalid_condition"
          }
        }
      }
    },
