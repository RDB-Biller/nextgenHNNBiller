    "/api/v1/webhooks/messaging-inbound": {
      "post": {
        "tags": [
          "Bills"
        ],
        "summary": "Inbound SMS/WhatsApp reply \u2014 bill verification, or a clinical check-in (x-webhook-secret)",
        "description": "Provider-agnostic \u2014 accepts { from, text, channel } plus common aliases (From/Body/sender/msisdn/message), with channel inferred from Twilio's whatsapp: From-prefix convention when omitted. Tried as a clinical check-in FIRST (see /api/v1/clinical-observations/link below and GET clinical-observations tag) \u2014 a keyword-led reading (e.g. \"BP 130/85\"), STOP, or HELP, or a bare numeric code unambiguously matching a pending clinical link. Anything that isn't falls straight through to bill-verification handling, unchanged: a bare YES/CONFIRM/OK confirms only when exactly one verification is pending for that phone; otherwise the patient can send the numeric reply code from their message instead, matched only within that phone's own pending verifications. A phone that has never used the clinical check-in feature sees no behaviour change at all. Secured the same way as /api/v1/webhooks/collection \u2014 a shared secret header, not a provider-specific request signature.",
        "responses": {
          "200": {
            "description": "{ ok: true, outcome, verificationId, clinicalLinkId }. Bill-verification outcomes: confirmed, ambiguous, wrong_code, locked, no_match, unrecognized. Clinical outcomes: recorded, confirmed, revoked, help, wrong_code, locked, expired, no_match. Exactly one of verificationId/clinicalLinkId is set, depending on which flow handled the message."
          },
          "401": {
            "description": "bad_signature"
          },
          "422": {
            "description": "missing_from_or_text"
          }
        }
      }
    },
