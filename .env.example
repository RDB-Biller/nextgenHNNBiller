# Server
PORT=4000

# Sandbox mode: 'true' (default) returns mock SBG responses so you can run with no
# bank credentials. Set to 'false' to call the real Stanbic API.
SBG_SANDBOX=true

# Stanbic SBG Transfer (only needed when SBG_SANDBOX=false)
SBG_BASE_URL=https://api.marketplaceuat.stanbic.com.gh
SBG_USERNAME=
SBG_PASSWORD=

# Collection gateway webhook shared secret (replace with HMAC verification)
COLLECTION_WEBHOOK_SECRET=dev-secret

# Notification fallback (avoid sending PHI here in production)
FALLBACK_EMAIL=hnnspprt@gmail.com

# --- Persistence (Railway) ---
# When DATABASE_URL is set, the app uses PostgreSQL and survives restarts / scales.
# Leave it unset to run the in-memory store (local/demo only).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Set PGSSL=true if connecting over a public Postgres URL (Railway public proxy);
# leave unset/false for Railway's internal *.railway.internal host.
# PGSSL=false
# PG_POOL_MAX=10

# --- Admin / revenue console ---
# Key for the IT-lead console at /app/admin.html and the /api/admin/* endpoints.
ADMIN_API_KEY=admin_demo_key_123

# --- Master control board (SaaS owners) ---
# Superkey for /api/platform/* and /app/platform.html. CHANGE THIS IN PRODUCTION.
PLATFORM_ADMIN_KEY=platform_demo_key_123

# --- Stanbic path prefix ---
# Marketplace gateway: /api/sbg-transfer   |   Direct smartapp host: (empty)
SBG_PATH_PREFIX=/api/sbg-transfer

# --- Outbound email (optional) ---
# Used by notify() and InsureCredit funder notes. Follows the same sandbox/live switch as SMS
# (Master Control -> Operating mode). Leave empty and email is logged, never sent.
# EMAIL_PROVIDER=resend        # resend | sendgrid
# EMAIL_API_KEY=
# EMAIL_FROM=HNN Biller <notes@your-verified-domain>

# --- AI adjudication (optional) ---
# Claude scores claims for the AI adjudication solution (Product Lab). Without a key the
# deterministic checks and the trained scorer still run; Claude is reported "not_configured".
# Model and effort are set per product in Product Lab (default claude-fable-5-1 at max effort).
# AI_LLM_ENABLED=false         # platform-wide Claude switch; seeds Master Control only. Off = no external AI dependency.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Phone verification for partner apps (Afriyie) ---
# Codes go out through the biller's own SMS provider (Africa's Talking). The receipt returned by
# POST /savings/api/verify/check is HMAC-signed with this key; share it with the TMS backend.
# PHONE_VERIFY_SIGNING_KEY=
